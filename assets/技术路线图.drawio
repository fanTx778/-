        <!-- 阶段一 -->
        <mxCell id="a1" value="资料调研与工况分析&#xa;（16 篇文献 · 抹灰标准 · 室内受限空间工况）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=SimSun;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="190" y="16" width="520" height="62" as="geometry" />
        </mxCell>

        <!-- 阶段二：方案比较 -->
        <mxCell id="b1" value="剪叉式&#xa;承载强、收缩比大&#xa;高位横向刚度低" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=SimSun;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="110" y="104" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="桅柱式&#xa;结构紧凑、垂直度好&#xa;承载有限、同步复杂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=SimSun;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="355" y="104" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="导轨附着式&#xa;贴墙精度高&#xa;需固定导轨、不便移动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=SimSun;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="104" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="确定方案：剪叉式主体 + 贴墙导向轮 + 四角螺旋调平支腿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=SimSun;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="194" width="520" height="48" as="geometry" />
        </mxCell>

